# Frontend environment example. Copy to `.env.production` (server) or `.env.local` (development).
# Next.js reads env files from this folder only, not from the repository root.
# NEXT_PUBLIC_* values are baked in at `npm run build`: change one, then build again.
# Never put secrets here; these values are visible in the browser.

# Public address of this site, without a trailing slash. Used for canonical URLs,
# hreflang, sitemap.xml, robots.txt, og:image, JSON-LD and llms.txt.
# Left unset (not empty) it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Backend API address as the browser reaches it.
# Left unset (not empty) it falls back to http://localhost:8080/api/v1.
NEXT_PUBLIC_API_URL=https://example.com/api/v1
