# =========================================================
# PDA - Project Delivery Assistant
# Example environment configuration
# Copy this file as .env and replace secret/example values.
# =========================================================

# Application
APP_ENV=dev
BACKEND_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL
DB_NAME=pda
DB_PORT=5432
DB_USERNAME=pda
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://postgres:5432/pda

# JWT
JWT_SECRET=change_me_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Google OAuth (optional; both empty = Google login disabled, both set = enabled)
# Create an OAuth client in Google Cloud Console; authorized redirect URI:
# http://localhost:8080/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional; both empty = GitHub login disabled, both set = enabled)
# Create an OAuth App in GitHub Developer settings; authorization callback URL:
# http://localhost:8080/api/v1/auth/oauth2/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub repository page (optional). Read-only, public repositories only. Empty = unauthenticated requests
# (GitHub allows 60/hour for the whole server); a personal access token with NO scopes raises it to 5000/hour.
# Server-side only: never exposed to the browser, never logged.
GITHUB_API_TOKEN=

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
INTERNAL_API_URL=http://backend:8080/api/v1

# Reverse proxy trust (rate limiting keys off the client IP; leave empty when the
# backend is reached directly, as in this project's docker-compose). Only set this
# to your reverse proxy's address (Tomcat RemoteIpFilter regex, e.g. 10\.0\.0\.1)
# if one is actually placed in front of the backend in production — otherwise a
# client could spoof X-Forwarded-For and dodge rate limiting.
TRUSTED_PROXY_CIDRS=

# Rate limits (optional). Leave these out in production: the built-in defaults are 5 sensitive requests (register,
# password forgot/reset ...) and 30 login / 30 refresh requests per 10 minutes per address, and 30 chat messages
# per 60 seconds per user. For a LOCAL machine that runs the Playwright tests many times in a row, raise them (and
# recreate the backend once) so the registrations of the test users never hit the limit:
#   AUTH_RATE_LIMIT_SENSITIVE_MAX_REQUESTS=1000
#   AUTH_RATE_LIMIT_LOGIN_MAX_REQUESTS=1000
#   AUTH_RATE_LIMIT_REFRESH_MAX_REQUESTS=1000
#   CHAT_SEND_MAX_MESSAGES=1000
# A value below 1 stops the backend from starting; a changed value is logged as a warning.

# Public contact form (optional). Every message goes to this one fixed address (server-side only, never chosen by the
# browser); the default is used when this is left out. The sender is MAIL_FROM and Reply-To is the visitor's address.
# The default is the public project inbox pdassistant.info@gmail.com (also shown on the site).
# CONTACT_RECIPIENT=pdassistant.info@gmail.com
# Per-address limits (10 minutes) for anonymous visit events and for the contact form. Production defaults: 600 and 5.
# ANALYTICS_RATE_LIMIT_MAX_REQUESTS=600
# CONTACT_RATE_LIMIT_MAX_REQUESTS=5
# Bot traps of the contact form (no CAPTCHA): minimum seconds between showing and sending the form (ISO-8601 duration),
# the oldest form timestamp accepted, and whether a missing timestamp counts as a bot (set true once the frontend sends it).
# CONTACT_MIN_FILL_TIME=PT3S
# CONTACT_MAX_FORM_AGE=PT24H
# CONTACT_REQUIRE_STARTED_AT=false

# Data retention (optional). A daily purge removes expired rows; the defaults are the published retention periods
# (analytics 12 months, ended sessions 30 days, contact records and support messages 12 months, audit events 24 months).
# The cron is in UTC (Spring 6-field format); "-" switches the purges off.
# RETENTION_CRON=0 30 3 * * *
# RETENTION_BATCH_SIZE=1000
# RETENTION_ANALYTICS_MONTHS=12
# RETENTION_USER_SESSIONS_DAYS=30
# RETENTION_CONTACT_MONTHS=12
# RETENTION_AUDIT_MONTHS=24

# API Documentation
API_DOCS_ENABLED=false

# Database / Flyway
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=validate

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_me

# Mail — Gmail SMTP. Registration, password reset, password change and account deletion all need mail:
# with MAIL_ENABLED=false those endpoints answer 503 and nobody can register.
# 1. Use a Gmail account as the sender and turn on 2-Step Verification for it (Google Account > Security).
# 2. Create an app password at https://myaccount.google.com/apppasswords (16 characters, shown once).
# 3. Copy this block to local .env, fill it in and set MAIL_ENABLED=true. Never commit the app password.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
# Gmail only sends as the signed-in account: MAIL_FROM and SMTP_USERNAME are the same full address.
MAIL_FROM=your-sender@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
# The 16-character app password, without spaces. Not the normal Gmail password.
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Another provider works the same way, e.g. Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend,
# SMTP_PASSWORD=<API key>, MAIL_FROM=<address on your verified domain>.

# Hashes the emailed 6-digit codes and links. Base64 of 32 random bytes: openssl rand -base64 32
EMAIL_VERIFICATION_HMAC_KEY=

# Two-step verification (TOTP)
# Encrypts authenticator secrets in the database. Base64 of 32 random bytes, a different value from the key
# above: openssl rand -base64 32. Changing it later disables every user's two-step verification.
TOTP_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO

# Organization images: private persistent volume target inside the backend container.
ORGANIZATION_MEDIA_STORAGE_PATH=/app/organization-media
