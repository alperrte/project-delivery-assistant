# =========================================================
# PDA - Project Delivery Assistant
# Example environment configuration
# Copy this file as .env and replace secret/example values.
# =========================================================

# Application
APP_ENV=dev
BACKEND_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL
DB_NAME=pda
DB_PORT=5432
DB_USERNAME=pda
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://postgres:5432/pda

# JWT
JWT_SECRET=change_me_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Google OAuth (optional; both empty = Google login disabled, both set = enabled)
# Create an OAuth client in Google Cloud Console; authorized redirect URI:
# http://localhost:8080/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional; both empty = GitHub login disabled, both set = enabled)
# Create an OAuth App in GitHub Developer settings; authorization callback URL:
# http://localhost:8080/api/v1/auth/oauth2/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub repository page (optional). Read-only, public repositories only. Empty = unauthenticated requests
# (GitHub allows 60/hour for the whole server); a personal access token with NO scopes raises it to 5000/hour.
# Server-side only: never exposed to the browser, never logged.
GITHUB_API_TOKEN=

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
INTERNAL_API_URL=http://backend:8080/api/v1

# Reverse proxy trust (rate limiting keys off the client IP; leave empty when the
# backend is reached directly, as in this project's docker-compose). Only set this
# to your reverse proxy's address (Tomcat RemoteIpFilter regex, e.g. 10\.0\.0\.1)
# if one is actually placed in front of the backend in production — otherwise a
# client could spoof X-Forwarded-For and dodge rate limiting.
TRUSTED_PROXY_CIDRS=

# Rate limits (optional). Leave these out in production: the built-in defaults are 5 sensitive requests (register,
# password forgot/reset ...) and 30 login / 30 refresh requests per 10 minutes per address, and 30 chat messages
# per 60 seconds per user. For a LOCAL machine that runs the Playwright tests many times in a row, raise them (and
# recreate the backend once) so the registrations of the test users never hit the limit:
#   AUTH_RATE_LIMIT_SENSITIVE_MAX_REQUESTS=1000
#   AUTH_RATE_LIMIT_LOGIN_MAX_REQUESTS=1000
#   AUTH_RATE_LIMIT_REFRESH_MAX_REQUESTS=1000
#   CHAT_SEND_MAX_MESSAGES=1000
# A value below 1 stops the backend from starting; a changed value is logged as a warning.

# API Documentation
API_DOCS_ENABLED=false

# Database / Flyway
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=validate

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_me

# Mail — Resend SMTP example. Verify your sending domain before enabling mail.
# Copy these settings to local .env and set MAIL_ENABLED=true only after filling
# MAIL_FROM and SMTP_PASSWORD. Never commit the Resend API key.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@your-verified-domain.example
EMAIL_VERIFICATION_HMAC_KEY=

# Resend API key goes in SMTP_PASSWORD; this app uses port 587 with STARTTLS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Logging
LOG_LEVEL=INFO

# Organization images: private persistent volume target inside the backend container.
ORGANIZATION_MEDIA_STORAGE_PATH=/app/organization-media
